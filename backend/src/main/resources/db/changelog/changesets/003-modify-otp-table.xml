<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Modify OTP table to support only registration OTP -->
    <changeSet id="003-modify-otp-table-for-registration" author="system">
        
        <!-- Drop foreign key constraints -->
        <dropForeignKeyConstraint baseTableName="otp" constraintName="fk_otp_user"/>
        <dropForeignKeyConstraint baseTableName="otp" constraintName="fk_otp_order"/>
        
        <!-- Drop columns not needed for registration -->
        <dropColumn tableName="otp" columnName="user_id"/>
        <dropColumn tableName="otp" columnName="order_id"/>
        
        <!-- Add email column for registration -->
        <addColumn tableName="otp">
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
