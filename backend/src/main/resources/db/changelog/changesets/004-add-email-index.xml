<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-add-email-index" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_user_email" tableName="users"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_user_email" tableName="users">
            <column name="email"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_user_email" tableName="users"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
