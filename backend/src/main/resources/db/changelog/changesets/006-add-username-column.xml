<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-add-username-column" author="system">
        <!-- Thêm cột username -->
        <addColumn tableName="users">
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>

        <!-- Tạo index cho username để tìm kiếm nhanh -->
        <createIndex indexName="idx_user_username" tableName="users">
            <column name="username"/>
        </createIndex>

        <!-- Migration data: Tạo username từ email cho các user hiện có -->
        <sql>
            UPDATE users 
            SET username = LOWER(SUBSTRING_INDEX(email, '@', 1))
            WHERE username IS NULL AND provider = 'LOCAL';
        </sql>

        <!-- Xử lý trường hợp username bị trùng bằng cách thêm số -->
        <sql>
            UPDATE users u1
            SET username = CONCAT(
                LOWER(SUBSTRING_INDEX(email, '@', 1)), 
                '_', 
                u1.id
            )
            WHERE username IN (
                SELECT username 
                FROM (SELECT username FROM users GROUP BY username HAVING COUNT(*) > 1) AS duplicates
            );
        </sql>

        <rollback>
            <dropIndex indexName="idx_user_username" tableName="users"/>
            <dropColumn tableName="users" columnName="username"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
