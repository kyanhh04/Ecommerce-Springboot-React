<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Remove status column from order_items table -->
    <changeSet id="001-remove-order-item-status" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="order_items" columnName="status"/>
        </preConditions>

        <dropColumn tableName="order_items" columnName="status"/>

        <rollback>
            <addColumn tableName="order_items">
                <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                    <constraints nullable="false"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
